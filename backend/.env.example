# Copy this file to .env for local development.
# Never commit real API keys.

# Application
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# CartPilot chat adapter. Values must come from your Volcengine Ark deployment.
CHAT_PROVIDER=doubao
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=
# Optional comma-separated trusted domains for image_url. Empty means base64 uploads only.
CHAT_IMAGE_ALLOWED_HOSTS=

# Retrieval defaults to offline lexical search.
RETRIEVAL_MODE=lexical
USE_RERANK=0

# Required together only when RETRIEVAL_MODE=hybrid.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Required only when USE_RERANK=1.
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_API_KEY=

# Optional compatibility aliases used by the legacy /api/v1 routes.
AI_PROVIDER=doubao
AI_MODEL=
AI_API_KEY=
# ARK_API_KEY=
# ARK_BASE_URL=
# ARK_MODEL=
